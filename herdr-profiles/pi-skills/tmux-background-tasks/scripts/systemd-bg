#!/usr/bin/env python3
"""Isolated systemd + files background-job backend (opt-in via PI_BG_BACKEND=systemd).

systemd owns process lifecycle; private files retain meta/state/log/result/
cancel-intent; completion is published through tmux-bg's unchanged secure
outbox (__prepare/__publish are the only Bash invocations, at notification).
No tmux, daemon, queue, registry, supervisor, or polling machinery.
"""
import json
import os
import re
import secrets
import shutil
import signal as signal_mod
import stat
import subprocess
import sys
import time

PREFIX = "pi-bg-"
UNIT_SUFFIX = ".service"
STOP_GRACE = "5s"
CONFIRM_MAX_SEC = 10
OUTPUT_MAX_BYTES = 4 * 1024 * 1024
GET_MAX_BYTES = 65536
MIN_SYSTEMD_VERSION = 255
ENV_NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
# PWD/OLDPWD/SHLVL/_ are shell-relative; PI_BG_OUTBOX_CHAIN must come only from
# the explicit unit property set at launch, never a stale caller value. The
# systemd lifecycle names are set by the manager for the unit (and for
# ExecStopPost); an inherited caller copy must never shadow them.
ENV_NAME_SKIP = {
    "PWD", "OLDPWD", "SHLVL", "_", "PI_BG_OUTBOX_CHAIN",
    "EXIT_CODE", "EXIT_STATUS", "SERVICE_RESULT",
    "MAINPID", "MANAGERPID", "INVOCATION_ID", "SYSTEMD_EXEC_PID",
    "MONITOR_SERVICE", "MONITOR_UNIT", "MONITOR_INVOCATION_ID", "MONITOR_PID",
    "NOTIFY_SOCKET", "WATCHDOG_USEC", "WATCHDOG_PID", "JOURNAL_STREAM",
    "LISTEN_FDS", "LISTEN_PID", "LISTEN_FDNAMES",
}
TASK_ID_RE = re.compile(r"^pi-bg-[a-z0-9][a-z0-9-]*-[0-9]+-[0-9]+-[0-9]+$")
SESSION_ID_RE = re.compile(r"^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$")
SIGNAL_NAME_RE = re.compile(r"^SIG[A-Z0-9]+$")
ACTIVE_STATES = {"active", "activating", "deactivating"}
INACTIVE_STATES = {"inactive", "failed", "dead"}
ACTIVE, INACTIVE, UNKNOWN = 0, 1, 2

SELF = os.path.realpath(__file__)
SELF_DIR = os.path.dirname(SELF)
TMUX_BG = os.path.join(SELF_DIR, "tmux-bg")
UID = os.geteuid()
SYSTEMCTL = None
SYSTEMD_RUN = None


def systemd_command_arg(value):
    """Quote one systemd Exec* argument without allowing specifier expansion."""
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%") + '"'


def die(msg, code=1):
    print(f"systemd-bg: {msg}", file=sys.stderr)
    sys.exit(code)


def usage():
    sys.stderr.write(
        "Usage:\n"
        "  systemd-bg start NAME CWD COMMAND\n"
        "  systemd-bg list\n"
        "  systemd-bg status TASK_ID\n"
        "  systemd-bg output TASK_ID [LINES]\n"
        "  systemd-bg kill TASK_ID\n"
        "  systemd-bg clean\n"
    )
    sys.exit(2)


def require_id(task_id):
    if not task_id or not TASK_ID_RE.fullmatch(task_id):
        die(f"invalid task id: {task_id or '<empty>'}")


def require_session_id(session):
    if not session or not SESSION_ID_RE.fullmatch(session):
        die(f"invalid Pi session id: {session or '<empty>'}")


def require_absolute_executable(path, label):
    if not (path.startswith("/") and os.path.isfile(path) and os.access(path, os.X_OK)):
        die(f"{label} must be an absolute executable file")


def require_systemd():
    global SYSTEMCTL, SYSTEMD_RUN
    SYSTEMCTL = shutil.which("systemctl")
    SYSTEMD_RUN = shutil.which("systemd-run")
    if not SYSTEMCTL:
        die("systemctl is required for the systemd backend")
    if not SYSTEMD_RUN:
        die("systemd-run is required for the systemd backend")
    try:
        first = subprocess.run([SYSTEMCTL, "--version"], capture_output=True,
                               text=True, timeout=10).stdout.splitlines()[0]
        version = int(first.split()[1])
    except (IndexError, ValueError, OSError, subprocess.SubprocessError):
        die("systemd version is unknown")
    if version < MIN_SYSTEMD_VERSION:
        die(f"systemd >= {MIN_SYSTEMD_VERSION} is required (host has {version})")
    # Same default systemctl applies; exported so the service environment
    # (including ExecStopPost) inherits a usable runtime path too.
    os.environ.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    try:
        reachable = subprocess.run([SYSTEMCTL, "--user", "show-environment"],
                                   capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.SubprocessError):
        reachable = False
    if not reachable:
        die(f"systemd user manager is not reachable (XDG_RUNTIME_DIR={os.environ['XDG_RUNTIME_DIR']})")


def agent_dir():
    path = os.environ.get("PI_CODING_AGENT_DIR") or os.path.expanduser("~/.pi/agent")
    if not os.path.isabs(path):
        die("PI_CODING_AGENT_DIR must be an absolute path")
    return path


def chain(agent, task_id=None):
    parts = [agent, os.path.join(agent, "tmux-bg"), os.path.join(agent, "tmux-bg", "jobs")]
    if task_id is not None:
        parts.append(os.path.join(parts[-1], task_id))
    return parts


def _check_dir(path, strict):
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode):
        die(f"job path is not a directory: {path}")
    if st.st_uid != UID:
        die(f"job path has the wrong owner: {path}")
    if st.st_mode & 0o22:
        die(f"job path is writable by group or other: {path}")
    if strict and (st.st_mode & 0o777) != 0o700:
        die(f"job directory is not mode 0700: {path}")


def validate(agent, task_id=None):
    parts = chain(agent, task_id)
    for index, path in enumerate(parts):
        try:
            _check_dir(path, task_id is not None and index == len(parts) - 1)
        except FileNotFoundError:
            die(f"job path is missing: {path}")
    return parts[-1]


def _dir_fd(path):
    if not hasattr(os, "O_NOFOLLOW"):
        die("descriptor-relative no-follow access is unavailable")
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW)
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != UID or st.st_mode & 0o22:
        os.close(fd)
        die(f"job directory changed during access: {path}")
    return fd


def init_job(agent, task_id):
    parts = chain(agent, task_id)
    parent = os.path.dirname(agent)
    try:
        st = os.lstat(parent)
    except OSError:
        die(f"job parent is unavailable: {parent}")
    if not stat.S_ISDIR(st.st_mode):
        die(f"job parent is not a directory: {parent}")
    for index, path in enumerate(parts):
        try:
            _check_dir(path, index == 3)
            if index == 3:
                die(f"job directory already exists: {path}")
        except FileNotFoundError:
            if index and not os.path.isdir(parts[index - 1]):
                die(f"job parent disappeared: {parts[index - 1]}")
            old = os.umask(0o077)
            try:
                os.mkdir(path, 0o700)
            except FileExistsError:
                if index == 3:
                    die(f"job directory already exists: {path}")
            finally:
                os.umask(old)
            _check_dir(path, index == 3)


def atomic_put(agent, task_id, name, data):
    job_dir = validate(agent, task_id)
    fd = _dir_fd(job_dir)
    temp = None
    try:
        temp = f".{name}.{os.getpid()}.{secrets.token_hex(4)}.tmp"
        tfd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                      0o600, dir_fd=fd)
        try:
            os.fchmod(tfd, 0o600)
            view = memoryview(data)
            while view:
                written = os.write(tfd, view)
                if written <= 0:
                    die("job storage write made no progress")
                view = view[written:]
            os.fsync(tfd)
            st = os.fstat(tfd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != UID or (st.st_mode & 0o7777) != 0o600 \
                    or st.st_size != len(data):
                die("job storage temporary failed verification")
        finally:
            os.close(tfd)
        os.rename(temp, name, src_dir_fd=fd, dst_dir_fd=fd)
        temp = None
    finally:
        if temp is not None:
            try:
                os.unlink(temp, dir_fd=fd)
            except OSError:
                pass
        os.close(fd)


def read_file(agent, task_id, name, limit=GET_MAX_BYTES):
    job_dir = validate(agent, task_id)
    dfd = _dir_fd(job_dir)
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dfd)
    finally:
        os.close(dfd)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != UID:
            die(f"job storage entry is not a regular file: {name}")
        data = os.read(fd, limit + 1)
        if len(data) > limit:
            die(f"job storage entry exceeds {limit} bytes: {name}")
        return data
    finally:
        os.close(fd)


def tail_file(agent, task_id, name, lines, limit=OUTPUT_MAX_BYTES):
    job_dir = validate(agent, task_id)
    dfd = _dir_fd(job_dir)
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dfd)
    finally:
        os.close(dfd)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != UID:
            die(f"job storage entry is not a regular file: {name}")
        size = st.st_size
        window = min(size, limit)
        data = b""
        if window:
            os.lseek(fd, size - window, os.SEEK_SET)
            data = os.read(fd, window)
    finally:
        os.close(fd)
    rows = data.split(b"\n")
    if rows and rows[-1] == b"":
        rows.pop()
    rows = rows[-lines:] if lines else []
    if rows:
        sys.stdout.buffer.write(b"\n".join(rows) + b"\n")


def marker(agent, task_id, name):
    fd = _dir_fd(validate(agent, task_id))
    try:
        try:
            os.lstat(name, dir_fd=fd)
            return True
        except FileNotFoundError:
            return False
    finally:
        os.close(fd)


def remove_marker(agent, task_id, name):
    fd = _dir_fd(validate(agent, task_id))
    try:
        try:
            os.unlink(name, dir_fd=fd)
        except FileNotFoundError:
            pass
    finally:
        os.close(fd)


def rm_job(agent, task_id):
    job_dir = validate(agent, task_id)
    fd = _dir_fd(job_dir)
    try:
        for entry in os.listdir(fd):
            st = os.lstat(entry, dir_fd=fd)
            if stat.S_ISDIR(st.st_mode):
                die(f"refusing to remove unexpected subdirectory: {entry}")
            os.unlink(entry, dir_fd=fd)
    finally:
        os.close(fd)
    os.rmdir(job_dir)


def list_ids(agent):
    root = chain(agent)[-1]
    try:
        st = os.lstat(root)
    except FileNotFoundError:
        return []
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != UID or st.st_mode & 0o22:
        die(f"job root failed validation: {root}")
    out = []
    for entry in sorted(os.listdir(root)):
        if not TASK_ID_RE.fullmatch(entry):
            continue
        try:
            st = os.lstat(os.path.join(root, entry))
        except OSError:
            continue
        if stat.S_ISDIR(st.st_mode):
            out.append(entry)
    return out


def _json_record(agent, task_id, name, required_keys):
    """Read and validate a retained JSON record; malformed returns None."""
    try:
        raw = read_file(agent, task_id, name)
    except (OSError, SystemExit):
        return None
    try:
        record = json.loads(raw)
    except ValueError:
        return None
    if not isinstance(record, dict) or record.get("schemaVersion") != 1:
        return None
    if record.get("taskId") != task_id:
        return None
    if sorted(record.keys()) != sorted(required_keys):
        return None
    return record


def read_meta(agent, task_id):
    record = _json_record(agent, task_id, "meta.json", [
        "schemaVersion", "taskId", "name", "cwd", "command", "unit",
        "piSessionId", "sessionPersisted", "startedAtEpochSec",
        "outboxChainIdentity"])
    if record is None:
        return None
    if not all(isinstance(record[k], str) for k in ("name", "cwd", "command", "unit")):
        return None
    if record["unit"] != task_id + UNIT_SUFFIX:
        return None
    if record["piSessionId"] is not None and not isinstance(record["piSessionId"], str):
        return None
    if not isinstance(record["sessionPersisted"], bool):
        return None
    if not isinstance(record["startedAtEpochSec"], int):
        return None
    identity = record.get("outboxChainIdentity")
    if identity is not None and not (isinstance(identity, str)
                                     and re.fullmatch(r"[0-9]+:[0-9]+(\|[0-9]+:[0-9]+){3}", identity)):
        return None
    return record


def read_result(agent, task_id):
    record = _json_record(agent, task_id, "result.json", [
        "schemaVersion", "taskId", "exitCode", "exitStatus", "serviceResult",
        "mainExit", "mainSignal", "cancelled", "finishedAtEpochSec"])
    if record is None:
        return None
    if not all(isinstance(record[k], str) for k in ("exitCode", "exitStatus", "serviceResult")):
        return None
    if record["mainExit"] is not None and not (isinstance(record["mainExit"], int)
                                               and 0 <= record["mainExit"] <= 255):
        return None
    if record["mainSignal"] is not None and not (isinstance(record["mainSignal"], str)
                                                 and SIGNAL_NAME_RE.fullmatch(record["mainSignal"])):
        return None
    if not isinstance(record["cancelled"], bool) or not isinstance(record["finishedAtEpochSec"], int):
        return None
    return record


def unit_probe(unit):
    """Return dict of native fields, or None when the manager cannot answer."""
    try:
        out = subprocess.run(
            [SYSTEMCTL, "--user", "show", unit,
             "--property=LoadState", "--property=ActiveState",
             "--property=SubState", "--property=MainPID"],
            capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    fields = {}
    for line in out.stdout.splitlines():
        key, _, value = line.partition("=")
        if key in ("LoadState", "ActiveState", "SubState", "MainPID"):
            fields[key] = value
    if not fields.get("LoadState") or not fields.get("ActiveState"):
        return None
    return fields


def unit_is_active(probe):
    """ACTIVE/INACTIVE/UNKNOWN — unrecognized states are never assumed inactive."""
    if probe is None:
        return UNKNOWN
    state = probe["ActiveState"]
    if state in ACTIVE_STATES:
        return ACTIVE
    if state in INACTIVE_STATES:
        return INACTIVE
    return UNKNOWN


def unit_pending_job(unit):
    """'yes'/'no'/'unknown' — a failed list-jobs is never proof of absence."""
    try:
        out = subprocess.run([SYSTEMCTL, "--user", "list-jobs", "--no-legend", "--no-pager"],
                             capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return "unknown"
    if out.returncode != 0:
        return "unknown"
    for line in out.stdout.splitlines():
        cols = line.split()
        if len(cols) >= 2 and cols[1] == unit:
            return "yes"
    return "no"


def start(args):
    if len(args) != 3:
        usage()
    name, cwd, command = args
    if not name.strip():
        die("task name must not be empty")
    if not os.path.isdir(cwd):
        die(f"working directory does not exist: {cwd}")
    if not command.strip():
        die("command must not be empty")
    require_systemd()

    agent = agent_dir()
    # Only an unset or empty PI_SESSION_ID selects the unbound "-" sentinel; a
    # literally supplied invalid value (e.g. "-") must fail validation here,
    # before any job directory, outbox, or unit exists.
    session = os.environ.get("PI_SESSION_ID")
    persisted = "0"
    if session:
        require_session_id(session)
        persisted = "1" if "PI_SESSION_FILE" in os.environ else "0"
    else:
        session = "-"

    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:32]
    if not slug:
        die("task name must contain a letter or number")
    task_id = f"{PREFIX}{slug}-{int(time.time())}-{os.getpid()}-{secrets.randbelow(65536)}"

    init_job(agent, task_id)
    job_dir = chain(agent, task_id)[-1]
    abs_cwd = os.path.realpath(cwd)

    outbox_identity = None
    if session != "-":
        prepared = subprocess.run([TMUX_BG, "__prepare", session],
                                 capture_output=True, text=True)
        if prepared.returncode != 0:
            die(f"could not create notification outbox; retained job id: {task_id}")
        # The chain identity captured now pins this launch's later publication,
        # matching the legacy pre-work capture; it is retained in the unit
        # environment and job metadata so the finalizer can verify both agree.
        outbox_identity = prepared.stdout.strip()
        if not re.fullmatch(r"[0-9]+:[0-9]+(\|[0-9]+:[0-9]+){3}", outbox_identity):
            die(f"could not capture notification chain identity; retained job id: {task_id}")
    meta = {
        "schemaVersion": 1, "taskId": task_id, "name": name, "cwd": abs_cwd,
        "command": command, "unit": task_id + UNIT_SUFFIX,
        "piSessionId": None if session == "-" else session,
        "sessionPersisted": persisted == "1",
        "startedAtEpochSec": int(time.time()),
        "outboxChainIdentity": outbox_identity,
    }
    try:
        atomic_put(agent, task_id, "meta.json",
                   (json.dumps(meta, separators=(",", ":")) + "\n").encode())
        atomic_put(agent, task_id, "state", b"launching\n")
        atomic_put(agent, task_id, "log", b"")
    except SystemExit:
        raise
    except OSError as error:
        die(f"could not record job metadata; retained job id: {task_id} ({error})")

    require_absolute_executable(SELF, "systemd backend")
    require_absolute_executable(TMUX_BG, "notification helper")

    bash = shutil.which("bash")
    if not bash:
        die("bash is required to run commands")
    run_args = [
        SYSTEMD_RUN, "--user", "--quiet", f"--unit={task_id}",
        "--service-type=exec", "--collect",
        "--property=ExitType=cgroup",
        "--property=KillMode=control-group",
        f"--property=TimeoutStopSec={STOP_GRACE}",
        "--property=SendSIGKILL=yes",
        f"--property=WorkingDirectory={abs_cwd}",
        "--property=StandardInput=null",
        f"--property=StandardOutput=append:{job_dir}/log",
        f"--property=StandardError=append:{job_dir}/log",
        "--property=ExecStopPost=" + " ".join(systemd_command_arg(value) for value in (SELF, "__finalize", task_id, session, persisted)),
        "--expand-environment=no",
    ]
    if outbox_identity is not None:
        run_args.append(f"--property=Environment=PI_BG_OUTBOX_CHAIN={outbox_identity}")
    # Caller environment is forwarded by NAME only; values never enter argv/logs.
    for var in sorted(os.environ):
        if ENV_NAME_RE.fullmatch(var) and var not in ENV_NAME_SKIP:
            run_args.append(f"--setenv={var}")
    run_args += [bash, "-c", command]

    try:
        launched = subprocess.run(run_args, timeout=30)
    except (OSError, subprocess.SubprocessError):
        launched = None
    if launched is None or launched.returncode != 0:
        # state stays "launching": a late materialization cannot be ruled out.
        die(f"systemd launch was not acknowledged; retained job id: {task_id}")
    try:
        atomic_put(agent, task_id, "state", b"running\n")
    except (OSError, SystemExit):
        die(f"systemd launch was acknowledged but state could not be retained; job id: {task_id}")
    print(task_id)


def status(args):
    if len(args) != 1:
        usage()
    task_id = args[0]
    require_id(task_id)
    require_systemd()
    agent = agent_dir()
    validate(agent, task_id)

    receipt = read_result(agent, task_id)
    probe = unit_probe(task_id + UNIT_SUFFIX)
    active = unit_is_active(probe)

    if receipt is not None:
        if active == ACTIVE:
            print(f"id={task_id} status=finalizing")
            return
        main_exit, main_signal = receipt["mainExit"], receipt["mainSignal"]
        exit_display = "unknown"
        if main_exit is not None:
            exit_display = str(main_exit)
        elif main_signal:
            number = getattr(signal_mod, main_signal, 0)
            if isinstance(number, int) and number > 0:
                exit_display = str(128 + number)
        service = receipt["serviceResult"]
        if not re.fullmatch(r"[A-Za-z0-9_-]+", service):
            service = "unknown"
        cancelled = " cancelled=1" if receipt["cancelled"] else ""
        # A validated receipt preserves the historical workload result, but an
        # unreadable/unrecognized native state is reported, not hidden.
        native = " native=unknown" if active == UNKNOWN else ""
        print(f"id={task_id} status=done exit={exit_display} service={service}{cancelled}{native}")
        return

    if active == ACTIVE:
        meta = read_meta(agent, task_id)
        command = meta["command"] if meta else ""
        print(f"id={task_id} status=running pid={probe.get('MainPID', '0')} command={command}")
        return
    if probe and probe["LoadState"] == "not-found":
        try:
            state = read_file(agent, task_id, "state", 64).decode(errors="replace").strip()
        except (OSError, SystemExit):
            state = ""
        print(f"id={task_id} status={'failed-start' if state == 'launching' else 'unknown'}")
        return
    print(f"id={task_id} status=unknown")


def list_jobs(_args):
    require_systemd()
    agent = agent_dir()
    root = chain(agent)[-1]
    try:
        validate(agent)
    except SystemExit:
        if not os.path.exists(root):
            return
        die("job storage failed validation")
    for task_id in list_ids(agent):
        # Reuse status logic without aborting the listing on one bad entry.
        proc = subprocess.run([SELF, "status", task_id], capture_output=True, text=True)
        print(proc.stdout.strip() if proc.returncode == 0 else f"id={task_id} status=unknown")


def output(args):
    if not 1 <= len(args) <= 2:
        usage()
    task_id = args[0]
    lines = args[1] if len(args) == 2 else "200"
    require_id(task_id)
    if not (lines.isdigit() and 1 <= int(lines) <= 10000):
        die("LINES must be an integer from 1 to 10000")
    agent = agent_dir()
    validate(agent, task_id)
    try:
        tail_file(agent, task_id, "log", int(lines))
    except (OSError, SystemExit) as error:
        die(f"output is unavailable for: {task_id} ({error})")


def kill(args):
    if len(args) != 1:
        usage()
    task_id = args[0]
    require_id(task_id)
    require_systemd()
    agent = agent_dir()
    validate(agent, task_id)
    unit = task_id + UNIT_SUFFIX

    receipt = read_result(agent, task_id)
    if receipt is not None:
        # A validated receipt is authoritative only when the native unit is
        # confirmed not active; mere file existence proves nothing.
        active = unit_is_active(unit_probe(unit))
        if active == INACTIVE:
            print(f"killed {task_id}")
            return
        if active == UNKNOWN:
            die(f"cancel unconfirmed: native unit state could not be verified for: {task_id}")
        # ACTIVE with a receipt is contradictory; fall through to real stop.

    try:
        state = read_file(agent, task_id, "state", 64).decode(errors="replace").strip()
    except (OSError, SystemExit):
        state = ""

    probe = unit_probe(unit)
    if probe is None:
        die(f"cancel unconfirmed: native unit state could not be read for: {task_id}")
    load = probe["LoadState"]

    if state == "launching":
        die(f"cancel unconfirmed: launch was never acknowledged and the unit may still materialize: {task_id}")
    if load == "not-found":
        # Only an explicitly acknowledged launch can justify not-found as proof
        # of termination; missing or unrecognized launch state stays unconfirmed.
        if state != "running":
            die(f"cancel unconfirmed: launch state could not be verified for: {task_id}")
        if unit_pending_job(unit) == "no":
            print(f"killed {task_id}")
            return
        die(f"cancel unconfirmed: job queue state could not be verified for: {task_id}")
    if load == "masked":
        die(f"cancel unconfirmed: native unit is masked: {task_id}")
    # Only an observed "loaded" proves the unit materialized; not-found is the
    # absence that state=launching must not turn into a false confirmation.
    seen_loaded = load == "loaded"

    # Cancellation intent is retained only after the launch is acknowledged and
    # a real unit is observed. Every unconfirmed path below removes it.
    try:
        atomic_put(agent, task_id, "cancel", f"{int(time.time())}\n".encode())
    except (OSError, SystemExit):
        die(f"could not retain cancellation intent for: {task_id}")

    try:
        stopped = subprocess.run([SYSTEMCTL, "--user", "stop", unit],
                                 capture_output=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        stopped = None
    if stopped is None or stopped.returncode != 0:
        remove_marker(agent, task_id, "cancel")
        die(f"cancel unconfirmed: stop request failed for: {task_id}")

    deadline = time.monotonic() + CONFIRM_MAX_SEC
    while time.monotonic() < deadline:
        probe = unit_probe(unit)
        if probe is not None:
            load = probe["LoadState"]
            active = unit_is_active(probe)
            if load == "loaded":
                seen_loaded = True
            if active == ACTIVE:
                time.sleep(0.1)
                continue
            if active == UNKNOWN:
                remove_marker(agent, task_id, "cancel")
                die(f"cancel unconfirmed: native unit entered an unrecognized state for: {task_id}")
            pending = unit_pending_job(unit)
            if pending == "unknown":
                remove_marker(agent, task_id, "cancel")
                die(f"cancel unconfirmed: job queue state could not be verified for: {task_id}")
            if pending == "yes":
                time.sleep(0.1)
                continue
            if read_result(agent, task_id) is not None:
                print(f"killed {task_id}")
                return
            if load == "not-found":
                # not-found alone is never proof while a late start could
                # materialize: require an observed loaded unit or an explicitly
                # acknowledged launch.
                if seen_loaded or state == "running":
                    print(f"killed {task_id}")
                    return
                remove_marker(agent, task_id, "cancel")
                die(f"cancel unconfirmed: unit vanished before a launch was observed: {task_id}")
            # Unit remains loaded but is confirmed not active: terminated.
            print(f"killed {task_id}")
            return
        time.sleep(0.1)
    remove_marker(agent, task_id, "cancel")
    die(f"cancel unconfirmed: unit still active after {CONFIRM_MAX_SEC}s: {task_id}")


def clean(_args):
    require_systemd()
    agent = agent_dir()
    root = chain(agent)[-1]
    try:
        validate(agent)
    except SystemExit:
        if not os.path.exists(root):
            print("cleaned 0 completed task(s)")
            return
        die("job storage failed validation")
    cleaned = skipped = 0
    for task_id in list_ids(agent):
        receipt = read_result(agent, task_id)
        if receipt is None:
            print(f"systemd-bg: kept {task_id} (not terminal)", file=sys.stderr)
            skipped += 1
            continue
        probe = unit_probe(task_id + UNIT_SUFFIX)
        active = unit_is_active(probe)
        if active != INACTIVE:
            reason = "still finalizing" if active == ACTIVE else "native state unavailable"
            print(f"systemd-bg: kept {task_id} ({reason})", file=sys.stderr)
            skipped += 1
            continue
        try:
            subprocess.run([SYSTEMCTL, "--user", "reset-failed", task_id + UNIT_SUFFIX],
                           capture_output=True)
        except OSError:
            pass
        try:
            rm_job(agent, task_id)
            cleaned += 1
        except (OSError, SystemExit):
            print(f"systemd-bg: kept {task_id} (storage removal failed)", file=sys.stderr)
            skipped += 1
    print(f"cleaned {cleaned} completed task(s)")


def finalize(args):
    """Trusted ExecStopPost finalizer: record the truthful native receipt, then
    publish the unchanged completion event to the origin session only."""
    if len(args) != 3:
        sys.exit(1)
    task_id, session, persisted = args
    if not TASK_ID_RE.fullmatch(task_id):
        sys.exit(1)
    if session != "-":
        if not SESSION_ID_RE.fullmatch(session):
            sys.exit(1)
    if persisted not in ("0", "1"):
        sys.exit(1)
    try:
        agent = agent_dir()
        validate(agent, task_id)
    except SystemExit:
        sys.exit(1)

    cancelled = marker(agent, task_id, "cancel")
    exit_code = os.environ.get("EXIT_CODE", "")
    exit_status = os.environ.get("EXIT_STATUS", "")
    service_result = os.environ.get("SERVICE_RESULT", "")
    main_exit = None
    main_signal = None
    if exit_code == "exited" and exit_status.isdigit() and int(exit_status) <= 255:
        main_exit = int(exit_status)
    elif exit_code in ("killed", "dumped") and exit_status:
        if exit_status.isdigit():
            try:
                main_signal = signal_mod.Signals(int(exit_status)).name
            except ValueError:
                main_signal = None
        else:
            # systemd reports bare signal names (e.g. "TERM"); members carry the
            # SIG prefix, so compare in prefixed form.
            name = exit_status if exit_status.startswith("SIG") else "SIG" + exit_status
            if name in signal_mod.Signals.__members__:
                main_signal = name
    # The receipt records native fields truthfully and never claims the unit is
    # already inactive: this hook runs while the unit is still finalizing.
    record = {
        "schemaVersion": 1, "taskId": task_id, "exitCode": exit_code,
        "exitStatus": exit_status, "serviceResult": service_result,
        "mainExit": main_exit, "mainSignal": main_signal,
        "cancelled": cancelled, "finishedAtEpochSec": int(time.time()),
    }
    try:
        atomic_put(agent, task_id, "result.json",
                   (json.dumps(record, separators=(",", ":")) + "\n").encode())
    except (OSError, SystemExit):
        sys.exit(1)

    # Explicit cancellation suppresses the completion wake (documented), and an
    # unbound session has no notifier to reach.
    # Re-read after committing the receipt so a cancellation confirmed during
    # the finalizing window still suppresses publication.
    if cancelled or marker(agent, task_id, "cancel") or session == "-":
        sys.exit(0)
    # Publishable outcomes: a clean exit 0 only when the service result is also
    # success (exit 0 + timeout/other stays suppressed), any classifiable
    # nonzero exit (failed), or any classifiable signal death (failed).
    # Unclassifiable results stay truthful in result.json and are not published.
    publishable = ((main_exit == 0 and service_result == "success")
                   or (main_exit is not None and main_exit != 0)
                   or main_signal is not None)
    if not publishable:
        sys.exit(0)

    # Publication is pinned to the outbox chain identity captured before launch
    # (same guarantee as the legacy in-memory pin). The unit environment copy
    # and the retained meta copy must agree; absence or divergence means the
    # original chain cannot be verified, so nothing is published. The retained
    # result above is unaffected either way.
    env_identity = os.environ.get("PI_BG_OUTBOX_CHAIN", "")
    meta = read_meta(agent, task_id)
    meta_identity = meta["outboxChainIdentity"] if meta else None
    if not env_identity or not meta_identity or env_identity != meta_identity:
        sys.exit(0)

    # Main result and service outcome stay distinct; an unclassifiable main
    # result remains truthful in result.json rather than manufacturing one.
    status_value = str(main_exit) if main_exit is not None else ""
    signal_value = main_signal[3:] if main_signal else ""
    if status_value or signal_value:
        try:
            subprocess.run([TMUX_BG, "__publish", task_id, session, persisted,
                            status_value, signal_value, env_identity],
                           capture_output=True, timeout=30)
        except (OSError, subprocess.SubprocessError):
            pass
    sys.exit(0)


def main():
    if len(sys.argv) < 2:
        usage()
    command, args = sys.argv[1], sys.argv[2:]
    if command == "__finalize":
        finalize(args)
        return
    verbs = {"start": start, "list": list_jobs, "status": status,
             "output": output, "kill": kill, "clean": clean}
    if command in verbs:
        verbs[command](args)
    else:
        usage()


if __name__ == "__main__":
    main()
